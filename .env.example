# ─────────────────────────────────────────────────────────────────────────
# Petal & Papers — environment variables
# Copy this file to `.env` and fill in real values as you get them.
# Nothing here is a real secret — this file is safe to commit.
# The app is designed to run with ALL of these unset: DB calls will fail
# loudly and clearly, but the app still boots, and email/image/payment
# calls fall back to safe no-op/log stubs (see lib/email, lib/cloudinary,
# lib/payments) until you supply real keys.
# ─────────────────────────────────────────────────────────────────────────

# --- Database (Neon Postgres) -----------------------------------------------
# Create a free project at https://neon.tech (no card required).
# DATABASE_URL: pooled connection (used by the app at runtime)
# DIRECT_DATABASE_URL: direct/unpooled connection (used by Prisma Migrate)
# Neon's dashboard gives you both — the "pooled" and "direct" connection strings.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---------------------------------------------------------------
# Any long random string works. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# Seeded once by `npm run db:seed` (FR-AUTH-06: no public admin registration).
# Change the password after first login.
ADMIN_EMAIL="admin@petalandpapers.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Petal & Papers Admin"

# --- Cloudinary (images/video) ------------------------------------------
# https://cloudinary.com — free tier is enough to start.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Brevo (transactional email) ----------------------------------------
# https://www.brevo.com — free tier is enough to start.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="hello@petalandpapers.com"
BREVO_SENDER_NAME="Petal & Papers"

# --- Pixabay (free stock images in the Design Studio) --------------------
# Free key: sign up at https://pixabay.com/api/docs/ (shown on that page once
# logged in). Leave empty to hide the "Images" tab.
PIXABAY_API_KEY=""

# --- Razorpay (payments) -------------------------------------------------
# https://razorpay.com — requires business KYC to go live; test mode keys
# are available immediately after signup.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Social profiles (footer icons + Google structured data) -------------
# Instagram (@petalandpapers) is built in. Add more as comma-separated full URLs, e.g. https://www.facebook.com/yourpage
SOCIAL_PROFILE_URLS=""
