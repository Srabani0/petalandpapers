// Petal & Papers — Prisma schema
// Mirrors PP SRS §4 (Database Schema) 1:1, with these deliberate deviations:
//  - Order <-> Payment is modeled as a clean one-to-one via Payment.orderId (unique FK)
//    instead of a redundant FK on both sides (SRS listed Order.paymentId too, which
//    would create a circular dependency at creation time).
//  - Product.finalPrice is kept as a stored column (per SRS) but is derived/maintained
//    by application code in lib/products.ts, not by the DB, since Prisma has no
//    generated-column support for this case.
//  - RefreshToken model is intentionally NOT here yet — it's added in the Phase 1
//    auth migration once the token rotation flow is implemented.
//
// Prisma 7 moved connection strings out of this file: `prisma.config.ts` (project
// root) holds the URL Migrate/Studio use, and the runtime client in lib/prisma.ts
// connects via a Neon driver adapter — see both files for the pooled/direct split.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum CustomizationFieldType {
  TEXT
  TEXTAREA
  DROPDOWN
  COLOR
  NUMBER
  IMAGE_UPLOAD
  FILE_UPLOAD
  CHECKBOX
  DATE
}

enum CustomizationStatus {
  PENDING
  RECEIVED
  IN_DESIGN
  AWAITING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CUSTOMIZATION_RECEIVED
  DESIGNING
  WAITING_APPROVAL
  APPROVED
  PRODUCTION
  READY
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
}

enum CouponType {
  PERCENTAGE
  FLAT_AMOUNT
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum InventoryChangeType {
  STOCK_IN
  STOCK_OUT
  ORDER_DEDUCTION
  ADJUSTMENT
  RETURN
}

// ─────────────────────────────────────────────────────────────────────────
// User & Address
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(CUSTOMER)
  isVerified         Boolean   @default(false)
  verificationToken  String?
  resetOTP           String?
  resetOTPExpiry     DateTime?
  isActive           Boolean   @default(true)
  loginAttempts      Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  addresses              Address[]
  cart                   Cart?
  customizationRequests  CustomizationRequest[]
  orders                 Order[]
  reviews                Review[]
  inventoryLogsPerformed InventoryLog[]
  refreshTokens          RefreshToken[]

  @@map("users")
}

// Added in Phase 1 (not in the original SRS table) to support refresh-token
// rotation + reuse detection (NFR-SEC-03) and per-device logout. We store a
// hash of the token, never the raw value.
model RefreshToken {
  id               String    @id @default(uuid())
  userId           String
  tokenHash        String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedByHash   String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  label         String?
  fullName      String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────
// Category & Product
// ─────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id                String        @id @default(uuid())
  name              String
  sku               String        @unique
  description       String
  categoryId        String
  price             Decimal       @db.Decimal(10, 2)
  discountPercent   Int           @default(0)
  finalPrice        Decimal       @db.Decimal(10, 2)
  stock             Int           @default(0)
  lowStockThreshold Int           @default(5)
  deliveryTime      String
  isCustomizable    Boolean       @default(false)
  requiresApproval  Boolean       @default(false)
  minPhotos         Int?
  maxPhotos         Int?
  status            ProductStatus @default(ACTIVE)
  videoUrl          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category               Category                @relation(fields: [categoryId], references: [id])
  images                 ProductImage[]
  customizationForm      CustomizationForm?
  cartItems              CartItem[]
  orderItems             OrderItem[]
  customizationRequests  CustomizationRequest[]
  reviews                Review[]
  inventoryLogs          InventoryLog[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id           String  @id @default(uuid())
  productId    String
  cloudinaryId String
  url          String
  altText      String?
  isPrimary    Boolean @default(false)
  sortOrder    Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─────────────────────────────────────────────────────────────────────────
// Dynamic Customization Engine
// ─────────────────────────────────────────────────────────────────────────

model CustomizationForm {
  id          String   @id @default(uuid())
  productId   String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  fields  CustomizationField[]

  @@map("customization_forms")
}

model CustomizationField {
  id            String                 @id @default(uuid())
  formId        String
  label         String
  fieldType     CustomizationFieldType
  placeholder   String?
  isRequired    Boolean                @default(true)
  options       Json?
  minValue      String?
  maxValue      String?
  sortOrder     Int                    @default(0)

  form CustomizationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("customization_fields")
}

model CustomizationRequest {
  id                  String              @id @default(uuid())
  customerId          String
  productId           String
  orderId             String?
  formData            Json
  uploadedPhotos      String[]
  referenceDesigns    String[]
  customerNotes       String?
  status              CustomizationStatus @default(PENDING)
  previewDesignUrl    String?
  adminNotes          String?
  approvalRequestedAt DateTime?
  approvedAt          DateTime?
  createdAt           DateTime            @default(now())

  customer   User        @relation(fields: [customerId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  order      Order?      @relation(fields: [orderId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([customerId])
  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@map("customization_requests")
}

// ─────────────────────────────────────────────────────────────────────────
// Cart
// ─────────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  couponId  String?
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id])
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id              String  @id @default(uuid())
  cartId          String
  productId       String
  quantity        Int     @default(1)
  unitPrice       Decimal @db.Decimal(10, 2)
  customizationId String?

  cart          Cart                   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id])
  customization CustomizationRequest?  @relation(fields: [customizationId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Order, OrderItem, Payment
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  customerId       String
  addressId        String
  addressSnapshot  Json
  couponId         String?
  subtotal         Decimal     @db.Decimal(10, 2)
  discountAmount   Decimal     @default(0) @db.Decimal(10, 2)
  couponDiscount   Decimal     @default(0) @db.Decimal(10, 2)
  deliveryCharge   Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING)
  trackingNumber   String?
  courierName      String?
  adminNotes       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer               User                    @relation(fields: [customerId], references: [id])
  address                Address                 @relation(fields: [addressId], references: [id])
  coupon                 Coupon?                 @relation(fields: [couponId], references: [id])
  items                  OrderItem[]
  payment                Payment?
  customizationRequests  CustomizationRequest[]
  reviews                Review[]
  inventoryLogs          InventoryLog[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  productId        String
  productSnapshot  Json
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  customizationId  String?

  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id])
  customization CustomizationRequest?  @relation(fields: [customizationId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String        @unique
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  status             PaymentStatus
  method             PaymentMethod?
  refundId           String?
  refundAmount       Decimal?      @db.Decimal(10, 2)
  createdAt          DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────
// Coupon
// ─────────────────────────────────────────────────────────────────────────

model Coupon {
  id                   String     @id @default(uuid())
  code                 String     @unique
  type                 CouponType
  value                Decimal    @db.Decimal(10, 2)
  minOrderValue        Decimal    @default(0) @db.Decimal(10, 2)
  maxDiscountAmount    Decimal?   @db.Decimal(10, 2)
  usageLimit           Int?
  usedCount            Int        @default(0)
  perUserLimit         Int        @default(1)
  expiresAt            DateTime?
  isActive             Boolean    @default(true)
  applicableCategories String[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  carts  Cart[]
  orders Order[]

  @@map("coupons")
}

// ─────────────────────────────────────────────────────────────────────────
// Review
// ─────────────────────────────────────────────────────────────────────────

model Review {
  id         String       @id @default(uuid())
  customerId String
  productId  String
  orderId    String
  rating     Int
  title      String?
  body       String
  images     String[]
  status     ReviewStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime     @default(now())

  customer User    @relation(fields: [customerId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@index([status])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory Log
// ─────────────────────────────────────────────────────────────────────────

model InventoryLog {
  id              String              @id @default(uuid())
  productId       String
  changeType      InventoryChangeType
  quantityBefore  Int
  quantityChange  Int
  quantityAfter   Int
  reason          String?
  orderId         String?
  performedBy     String
  createdAt       DateTime            @default(now())

  product         Product @relation(fields: [productId], references: [id])
  order           Order?  @relation(fields: [orderId], references: [id])
  performedByUser User    @relation(fields: [performedBy], references: [id])

  @@index([productId])
  @@map("inventory_logs")
}
